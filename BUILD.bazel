load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("@symbolic_crate_index//:defs.bzl", "aliases", "all_crate_deps")

# Base common library - no internal dependencies
rust_library(
    name = "symbolic-common",
    srcs = glob(["symbolic-common/src/**/*.rs"]),
    aliases = aliases(),
    crate_features = [
        "serde",
    ],
    crate_name = "symbolic_common",
    edition = "2021",
    proc_macro_deps = all_crate_deps(
        package_name = "symbolic-common",
        proc_macro = True,
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(package_name = "symbolic-common") + [
        "@symbolic_crate_index//:serde-1.0.217",
    ],
)

# Demangle library - depends on symbolic-common
rust_library(
