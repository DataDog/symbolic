        "rust",
        "swift",
    ],
    crate_name = "symbolic_demangle",
    edition = "2021",
    proc_macro_deps = all_crate_deps(
        package_name = "symbolic-demangle",
        proc_macro = True,
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(package_name = "symbolic-demangle") + [":symbolic-common"],
)

